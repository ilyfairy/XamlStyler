<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Test mixing of self-closing and explicit end tags  -->
    <StackPanel>
        <Button Content="Self-closing" />
        <Button Content="Explicit end tag"></Button>
        <TextBlock Text="Self-closing text" />
        <TextBlock Text="Explicit end tag text"></TextBlock>
        <CheckBox Content="Self-closing checkbox" />
        <CheckBox Content="Explicit end tag checkbox"></CheckBox>
        <!--  Empty elements with different styles  -->
        <Border />
        <Border></Border>
        <Grid />
        <Grid></Grid>
    </StackPanel>
</Window>
